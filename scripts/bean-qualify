#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if [[ ! -x "$ROOT/.venv/bin/python" ]]; then
  echo "Missing .venv; run uv sync --extra quant first." >&2
  exit 1
fi

GEN_SECONDS="${GEN_SECONDS:-10}"
PROFILE="${PROFILE:-profiles/bean-qualify.toml}"

exec "$ROOT/.venv/bin/python" - "$GEN_SECONDS" "$PROFILE" <<'PY'
from __future__ import annotations

import json
import math
import os
import platform
import sys
import time
from pathlib import Path

import torch
import torchaudio

from tinytauk import TinyTAuK
from tinytauk.reference import DEFAULT_INSTRUCTION, memory_sample


def cpu_model() -> str:
    path = Path("/proc/cpuinfo")
    if path.is_file():
        for line in path.read_text().splitlines():
            if line.startswith("model name"):
                return line.split(":", 1)[1].strip()
    return platform.processor() or "unknown"


def mem_total_mb() -> float | None:
    path = Path("/proc/meminfo")
    if path.is_file():
        for line in path.read_text().splitlines():
            if line.startswith("MemTotal:"):
                return float(line.split()[1]) / 1024.0
    return None


gen_seconds = float(sys.argv[1])
if not math.isfinite(gen_seconds) or gen_seconds <= 0:
    raise SystemExit("GEN_SECONDS must be a positive finite number")

profile = Path(sys.argv[2])
if not profile.is_file():
    raise SystemExit(f"Missing profile: {profile}")

output_dir = Path("benchmarks/results/bean-qualify")
output_dir.mkdir(parents=True, exist_ok=True)
output_wav = output_dir / "bean-qualify.wav"
output_json = output_dir / "bean-qualify.json"

before = memory_sample()
load_started = time.perf_counter()
engine = TinyTAuK.from_config(profile)
load_seconds = time.perf_counter() - load_started
after_load = memory_sample()

result = engine.generate(
    DEFAULT_INSTRUCTION,
    gen_seconds=gen_seconds,
    seed=42,
)
after_generate = memory_sample()

if not isinstance(result.audio, torch.Tensor):
    raise SystemExit("TinyTAuK returned a non-tensor audio result")
if result.audio.ndim != 2 or result.audio.shape[0] != 1:
    raise SystemExit(f"Unexpected audio shape: {tuple(result.audio.shape)}")

finite = bool(torch.isfinite(result.audio).all())
expected_samples = int(round(gen_seconds * result.sample_rate))
shape_match = result.audio.shape[-1] == expected_samples
sample_rate_match = result.sample_rate == 24_000
peak_amplitude = float(result.audio.abs().max()) if result.audio.numel() else 0.0
rms = float(torch.sqrt(torch.mean(result.audio.square()))) if result.audio.numel() else 0.0

if finite:
    torchaudio.save(output_wav, result.audio, result.sample_rate)

structural_pass = shape_match and sample_rate_match and finite
latency_pass = result.wall_seconds < 8.0 * 60.0
deployment_gate_pass = structural_pass and latency_pass

report = {
    "profile": str(profile),
    "gen_seconds_requested": gen_seconds,
    "cpu_model": cpu_model(),
    "logical_cpus": os.cpu_count(),
    "torch_num_threads": torch.get_num_threads(),
    "torch_num_interop_threads": torch.get_num_interop_threads(),
    "torch": str(torch.__version__),
    "platform": platform.platform(),
    "mem_total_mb": mem_total_mb(),
    "conditioner_dtype": engine.config.conditioner.dtype,
    "generator_dtype": engine.config.generator.dtype,
    "vae_dtype": engine.config.vae.dtype,
    "audio_shape": list(result.audio.shape),
    "sample_rate": result.sample_rate,
    "generated_seconds": result.generated_seconds,
    "shape_match": shape_match,
    "sample_rate_match": sample_rate_match,
    "finite": finite,
    "peak_amplitude": peak_amplitude,
    "rms": rms,
    "load_seconds": load_seconds,
    "load_stage_seconds": engine.load_stage_seconds,
    "generate_seconds": result.wall_seconds,
    "generate_stage_seconds": result.stage_seconds,
    "realtime_factor": result.wall_seconds / result.generated_seconds,
    "rss_before_mb": before.current_rss_mb,
    "rss_after_load_mb": after_load.current_rss_mb,
    "rss_after_generate_mb": after_generate.current_rss_mb,
    "peak_rss_mb": max(before.peak_rss_mb, after_load.peak_rss_mb, after_generate.peak_rss_mb),
    "structural_pass": structural_pass,
    "latency_under_8_min": latency_pass,
    "deployment_gate_pass": deployment_gate_pass,
    "output_wav": str(output_wav),
}

output_json.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
print(json.dumps(report, indent=2, sort_keys=True))

if not structural_pass:
    raise SystemExit(1)
PY
