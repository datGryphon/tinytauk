#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

REFERENCE_WAV="${1:-}"
RESULT_ROOT="${RESULT_ROOT:-benchmarks/results/quant-sweep-v2}"
GEN_SECONDS="${GEN_SECONDS:-3}"
WARM_RUNS="${WARM_RUNS:-1}"
SEEDS="${SEEDS:-42}"
CANDIDATES="${CANDIDATES:-q16 q8 q4 g16 g8 g4}"
MODE="${MODE:-text}"

if [[ "$MODE" != "text" && "$MODE" != "reference" && "$MODE" != "both" ]]; then
  echo "MODE must be text, reference, or both" >&2
  exit 2
fi
if [[ "$MODE" != "text" && -z "$REFERENCE_WAV" ]]; then
  echo "reference mode requires REFERENCE_WAV as the first argument" >&2
  exit 2
fi

status=0
if [[ "$MODE" == "text" || "$MODE" == "both" ]]; then
  for name in $CANDIDATES; do
    profile="profiles/sweep/cpu-${name}.toml"
    echo
    echo "================ $name text benchmark ================"
    if ! PROFILE="$profile" \
        GEN_SECONDS="$GEN_SECONDS" \
        WARM_RUNS="$WARM_RUNS" \
        OUT_DIR="$RESULT_ROOT/$name/text" \
        bash scripts/cpu-bench; then
      echo "$name text benchmark failed" >&2
      status=1
    fi
  done
fi

if [[ "$MODE" == "reference" || "$MODE" == "both" ]]; then
  for name in $CANDIDATES; do
    profile="profiles/sweep/cpu-${name}.toml"
    echo
    echo "================ $name reference benchmark ================"
    if ! PROFILE="$profile" \
        GEN_SECONDS="$GEN_SECONDS" \
        SEEDS="$SEEDS" \
        scripts/cpu-reference-audio-smoke \
        "$REFERENCE_WAV" "$RESULT_ROOT/$name/reference"; then
      echo "$name reference benchmark failed" >&2
      status=1
    fi
  done
fi

exit "$status"
