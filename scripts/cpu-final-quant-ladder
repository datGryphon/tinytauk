#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "usage: $0 REFERENCE_WAV [OUTPUT_DIR]" >&2
  exit 2
fi

REFERENCE_WAV="$1"
OUT_DIR="${2:-benchmarks/results/cpu-final-quant-ladder}"
GEN_SECONDS_VALUE="${GEN_SECONDS:-4.5}"
SEED_VALUE="${SEED:-42}"
BASELINE_WAV_VALUE="${BASELINE_WAV:-benchmarks/results/local-upstream-parity-v4/clone-seed-42.wav}"

mkdir -p "$OUT_DIR"

if [[ ! -f "$BASELINE_WAV_VALUE" ]]; then
  echo "=== parity baseline not found; generating it once ==="
  baseline_dir="$OUT_DIR/baseline"
  rm -rf "$baseline_dir"
  PROFILE=profiles/sweep/cpu-upstream-parity.toml \
  GEN_SECONDS="$GEN_SECONDS_VALUE" \
  SEEDS="$SEED_VALUE" \
    scripts/cpu-reference-audio-smoke "$REFERENCE_WAV" "$baseline_dir" \
    2>&1 | tee "$OUT_DIR/baseline.log"
  BASELINE_WAV_VALUE="$baseline_dir/clone-seed-$SEED_VALUE.wav"
fi

run_case() {
  local name="$1"
  local profile="$2"
  local case_dir="$OUT_DIR/$name"

  echo
  echo "=== final quant case: $name ==="
  echo "profile: $profile"
  rm -rf "$case_dir"
  mkdir -p "$case_dir"

  set +e
  PROFILE="$profile" \
  GEN_SECONDS="$GEN_SECONDS_VALUE" \
  SEEDS="$SEED_VALUE" \
    scripts/cpu-reference-audio-smoke "$REFERENCE_WAV" "$case_dir" \
    2>&1 | tee "$OUT_DIR/$name.log"
  local status=${PIPESTATUS[0]}
  set -e
  printf '%s\n' "$status" > "$case_dir/exit-status"

  if [[ "$status" -ne 0 ]]; then
    echo "case $name failed with exit status $status; continuing" >&2
  fi
}

# Qwen quantization ladder; Flux and VAE remain FP32.
run_case qwen-w8 profiles/sweep/cpu-opt-qwen-int8.toml
run_case qwen-w4 profiles/sweep/cpu-final-qwen-w4.toml
run_case qwen-a8w8 profiles/sweep/cpu-final-qwen-a8w8.toml

# Flux ladder; Qwen stays at the repaired upstream-parity BF16 baseline and VAE stays FP32.
run_case flux-bf16 profiles/sweep/cpu-final-flux-bf16.toml
run_case flux-w8 profiles/sweep/cpu-final-flux-w8.toml
run_case flux-w4 profiles/sweep/cpu-final-flux-w4.toml

BASELINE_WAV="$BASELINE_WAV_VALUE" \
OUT_DIR="$OUT_DIR" \
SEED_VALUE="$SEED_VALUE" \
uv run python - <<'PY'
from __future__ import annotations

import json
import math
import os
from pathlib import Path

import torch
import torchaudio

baseline_wav = Path(os.environ["BASELINE_WAV"])
out_dir = Path(os.environ["OUT_DIR"])
seed = int(os.environ["SEED_VALUE"])
cases = ("qwen-w8", "qwen-w4", "qwen-a8w8", "flux-bf16", "flux-w8", "flux-w4")


def load_mono(path: Path) -> tuple[torch.Tensor, int]:
    audio, sample_rate = torchaudio.load(path)
    if audio.shape[0] > 1:
        audio = audio.mean(dim=0, keepdim=True)
    return audio.float().reshape(-1), sample_rate


def cosine(left: torch.Tensor, right: torch.Tensor) -> float:
    denom = float(torch.linalg.vector_norm(left) * torch.linalg.vector_norm(right))
    if denom == 0.0:
        return 1.0 if torch.equal(left, right) else 0.0
    return float(torch.dot(left, right)) / denom


def frame_rms(audio: torch.Tensor, frame: int = 480) -> torch.Tensor:
    usable = audio.numel() // frame * frame
    if usable == 0:
        return torch.empty(0)
    return audio[:usable].reshape(-1, frame).square().mean(dim=1).sqrt()


baseline, baseline_sr = load_mono(baseline_wav)
baseline_result_path = baseline_wav.parent / "result.json"
baseline_result = (
    json.loads(baseline_result_path.read_text()) if baseline_result_path.is_file() else None
)
baseline_peak_rss = (
    float(baseline_result["peak_rss_mb"]) if baseline_result is not None else None
)
baseline_condition = (
    float(baseline_result["condition_seconds"]) if baseline_result is not None else None
)
baseline_run = baseline_result["runs"][0] if baseline_result is not None else None
baseline_generate = float(baseline_run["wall_seconds"]) if baseline_run is not None else None
baseline_request = (
    baseline_condition + baseline_generate
    if baseline_condition is not None and baseline_generate is not None
    else None
)

rows: list[dict[str, object]] = []
for name in cases:
    case_dir = out_dir / name
    status_path = case_dir / "exit-status"
    status = int(status_path.read_text().strip()) if status_path.is_file() else None
    wav_path = case_dir / f"clone-seed-{seed}.wav"
    result_path = case_dir / "result.json"

    row: dict[str, object] = {"case": name, "exit_status": status}
    if status != 0 or not wav_path.is_file() or not result_path.is_file():
        row["status"] = "failed"
        rows.append(row)
        continue

    candidate, sample_rate = load_mono(wav_path)
    result = json.loads(result_path.read_text())
    run = result["runs"][0]
    condition_seconds = float(result["condition_seconds"])
    generate_seconds = float(run["wall_seconds"])
    total_request_seconds = condition_seconds + generate_seconds
    row.update(
        {
            "status": "ok",
            "sample_rate": sample_rate,
            "shape_match": sample_rate == baseline_sr and candidate.shape == baseline.shape,
            "peak_rss_mb": float(result["peak_rss_mb"]),
            "rss_after_load_mb": float(result["rss_after_load_mb"]),
            "rss_after_conditioning_mb": float(result["rss_after_conditioning_mb"]),
            "condition_seconds": condition_seconds,
            "generate_seconds": generate_seconds,
            "total_request_seconds": total_request_seconds,
            "generator_seconds": float(run["stage_seconds"]["generator"]),
            "vae_seconds": float(run["stage_seconds"]["vae"]),
            "rtf": float(run["rtf"]),
            "rms": float(run["rms"]),
        }
    )

    if baseline_peak_rss is not None:
        row["rss_reduction_pct"] = 100.0 * (
            baseline_peak_rss - float(result["peak_rss_mb"])
        ) / baseline_peak_rss
    if baseline_condition is not None:
        row["conditioning_speedup"] = baseline_condition / condition_seconds
    if baseline_generate is not None:
        row["generation_speedup"] = baseline_generate / generate_seconds
    if baseline_request is not None:
        row["request_speedup"] = baseline_request / total_request_seconds

    if sample_rate == baseline_sr and candidate.shape == baseline.shape:
        diff = candidate - baseline
        denom = float(torch.linalg.vector_norm(baseline))
        row.update(
            {
                "waveform_cosine": cosine(candidate, baseline),
                "relative_l2": float(torch.linalg.vector_norm(diff)) / max(denom, 1e-12),
                "mean_abs_error": float(diff.abs().mean()),
                "max_abs_error": float(diff.abs().max()),
                "envelope_cosine": cosine(frame_rms(candidate), frame_rms(baseline)),
                "rms_ratio": float(torch.sqrt(candidate.square().mean()))
                / max(float(torch.sqrt(baseline.square().mean())), 1e-12),
            }
        )
    rows.append(row)

summary = {
    "baseline_wav": str(baseline_wav),
    "baseline_sample_rate": baseline_sr,
    "baseline_peak_rss_mb": baseline_peak_rss,
    "baseline_condition_seconds": baseline_condition,
    "baseline_generate_seconds": baseline_generate,
    "baseline_request_seconds": baseline_request,
    "cases": rows,
}
(out_dir / "summary.json").write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n")

print("\n=== final CPU quant ladder summary ===")
header = (
    f"{'case':11s} {'status':7s} {'wav_cos':>9s} {'env_cos':>9s} {'rel_l2':>9s} "
    f"{'peak_mb':>9s} {'cond_s':>8s} {'gen_s':>8s} {'req_s':>8s} {'req_x':>7s}"
)
print(header)
for row in rows:
    if row.get("status") != "ok":
        print(f"{str(row['case']):11s} failed")
        continue

    def fmt(key: str, width: int, precision: int = 4) -> str:
        value = row.get(key)
        if value is None or not isinstance(value, (int, float)) or not math.isfinite(float(value)):
            return "-".rjust(width)
        return f"{float(value):{width}.{precision}f}"

    print(
        f"{str(row['case']):11s} {'ok':7s} "
        f"{fmt('waveform_cosine', 9, 5)} {fmt('envelope_cosine', 9, 5)} "
        f"{fmt('relative_l2', 9, 5)} {fmt('peak_rss_mb', 9, 1)} "
        f"{fmt('condition_seconds', 8, 1)} {fmt('generate_seconds', 8, 1)} "
        f"{fmt('total_request_seconds', 8, 1)} {fmt('request_speedup', 7, 2)}"
    )
print(f"\nFull JSON: {out_dir / 'summary.json'}")
PY
