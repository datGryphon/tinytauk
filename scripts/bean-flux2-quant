#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PYTHON="$ROOT/.venv/bin/python"
if [[ ! -x "$PYTHON" ]]; then
  echo "Missing .venv; run uv sync --extra quant first." >&2
  exit 1
fi

OUT_DIR="${OUT_DIR:-benchmarks/results/bean-flux2-quant}"
MIN_WEIGHT_ELEMENTS="${MIN_WEIGHT_ELEMENTS:-1000000}"
MODES="${MODES:-fp32 int8-attn int8-ff int8-core int8-all}"
mkdir -p "$OUT_DIR"

COND_PATH="$OUT_DIR/conditioning.pt"
MASK_PATH="$OUT_DIR/context_mask.pt"

if [[ "${REBUILD_CONDITIONING:-0}" == "1" || ! -f "$COND_PATH" || ! -f "$MASK_PATH" ]]; then
  echo "Preparing fixed benchmark conditioning fixture..." >&2
  COND_PATH="$COND_PATH" MASK_PATH="$MASK_PATH" "$PYTHON" - <<'PY'
from __future__ import annotations

import os
from pathlib import Path

import torch

from tinytauk.conditioning.transformers import TransformersConditioner
from tinytauk.config import ComponentConfig, ModelConfig
from tinytauk.reference import DEFAULT_INSTRUCTION, resolve_auk_snapshot
from tinytauk.types import GenerationRequest

cond_path = Path(os.environ["COND_PATH"])
mask_path = Path(os.environ["MASK_PATH"])
snapshot, checkpoint_path = resolve_auk_snapshot("tencent/AuK-Flash")
conditioner = TransformersConditioner(
    ModelConfig(),
    ComponentConfig(backend="transformers", device="cpu", dtype="fp32"),
    auk_checkpoint=checkpoint_path,
)
conditioning = conditioner.encode(
    GenerationRequest(instruction=DEFAULT_INSTRUCTION, gen_seconds=3.0, seed=42)
)
torch.save(conditioning.values.detach().cpu(), cond_path)
if conditioning.attention_mask is None:
    raise SystemExit("Conditioner returned no attention mask")
torch.save(conditioning.attention_mask.detach().cpu(), mask_path)
print(f"fixture_snapshot={snapshot}")
print(f"conditioning_shape={tuple(conditioning.values.shape)}")
PY
fi

for mode in $MODES; do
  case "$mode" in
    fp32|int8-attn|int8-ff|int8-core|int8-all) ;;
    *) echo "Unknown mode: $mode" >&2; exit 2 ;;
  esac

  echo >&2
  echo "================ $mode ================" >&2
  MODE="$mode" \
  OUT_PATH="$OUT_DIR/$mode.json" \
  COND_PATH="$COND_PATH" \
  MASK_PATH="$MASK_PATH" \
  MIN_WEIGHT_ELEMENTS="$MIN_WEIGHT_ELEMENTS" \
  "$PYTHON" - <<'PY'
from __future__ import annotations

import gc
import json
import math
import os
import time
import wave
from pathlib import Path

import torch
import torch.nn.functional as F
from torch import nn

from tinytauk.config import ComponentConfig, ModelConfig
from tinytauk.generator.pytorch import PyTorchAuKGenerator
from tinytauk.quant.dynamic import (
    apply_dynamic_int8_linears,
    configure_x86_quantized_engine,
    select_dynamic_int8_linears,
)
from tinytauk.reference import DEFAULT_INSTRUCTION, memory_sample, resolve_auk_snapshot
from tinytauk.types import Conditioning, GenerationRequest
from tinytauk.vae.pytorch import PyTorchVAE

mode = os.environ["MODE"]
out_path = Path(os.environ["OUT_PATH"])
min_weight_elements = int(os.environ["MIN_WEIGHT_ELEMENTS"])
conditioning = Conditioning(
    values=torch.load(os.environ["COND_PATH"], map_location="cpu", weights_only=True),
    attention_mask=torch.load(os.environ["MASK_PATH"], map_location="cpu", weights_only=True),
)
_, checkpoint_path = resolve_auk_snapshot("tencent/AuK-Flash")
snapshot = checkpoint_path.parent


def similarity(actual: torch.Tensor, expected: torch.Tensor) -> dict[str, float | None]:
    if actual.shape != expected.shape or not actual.numel():
        return {
            "max_abs_error": None,
            "mean_abs_error": None,
            "snr_db": None,
            "cosine_similarity": None,
        }
    error = actual.float() - expected.float()
    signal_power = float(expected.float().pow(2).mean())
    noise_power = float(error.pow(2).mean())
    return {
        "max_abs_error": float(error.abs().max()),
        "mean_abs_error": float(error.abs().mean()),
        "snr_db": math.inf if noise_power == 0.0 else 10.0 * math.log10(signal_power / noise_power),
        "cosine_similarity": float(
            F.cosine_similarity(actual.float().flatten(), expected.float().flatten(), dim=0)
        ),
    }


def write_pcm16_wav(path: Path, audio: torch.Tensor, sample_rate: int) -> None:
    samples = audio.squeeze(0).contiguous().to(torch.float32).clamp(-1.0, 1.0)
    pcm = (samples * 32767.0).round().to(torch.int16).numpy().tobytes()
    with wave.open(str(path), "wb") as handle:
        handle.setnchannels(1)
        handle.setsampwidth(2)
        handle.setframerate(sample_rate)
        handle.writeframes(pcm)


before = memory_sample()
load_started = time.perf_counter()
generator = PyTorchAuKGenerator(
    ModelConfig(),
    ComponentConfig(backend="pytorch", device="cpu", dtype="fp32"),
    model_snapshot=snapshot,
)
load_seconds = time.perf_counter() - load_started
after_load = memory_sample()

quant_engine: str | None = None
selected_names: tuple[str, ...] = ()
selected_weight_elements = 0
quantize_seconds = 0.0
if mode != "fp32":
    selected_names = select_dynamic_int8_linears(
        generator.transformer,
        min_weight_elements=min_weight_elements,
        include_sensitive=mode == "int8-all",
    )
    if mode == "int8-attn":
        selected_names = tuple(name for name in selected_names if ".attn." in name)
    elif mode == "int8-ff":
        selected_names = tuple(name for name in selected_names if ".ff" in name)

    modules = dict(generator.transformer.named_modules())
    selected_weight_elements = sum(
        int(module.weight.numel())
        for name in selected_names
        if isinstance((module := modules[name]), nn.Linear)
    )
    quant_engine = configure_x86_quantized_engine()
    quant_started = time.perf_counter()
    apply_dynamic_int8_linears(generator.transformer, selected_names)
    quantize_seconds = time.perf_counter() - quant_started
    gc.collect()

after_quant = memory_sample()
generate_started = time.perf_counter()
actual = generator.generate_latents(
    GenerationRequest(instruction=DEFAULT_INSTRUCTION, gen_seconds=3.0, seed=42),
    conditioning,
).detach().cpu()
generate_seconds = time.perf_counter() - generate_started
after_generate = memory_sample()

baseline_latent_path = out_path.parent / "fp32-latent.pt"
if mode == "fp32":
    torch.save(actual, baseline_latent_path)
    expected_latent = actual
else:
    if not baseline_latent_path.is_file():
        raise SystemExit(f"Missing FP32 baseline latent: {baseline_latent_path}; include fp32 in MODES first")
    expected_latent = torch.load(baseline_latent_path, map_location="cpu", weights_only=True)
latent_metrics = similarity(actual, expected_latent)

del generator
gc.collect()

vae_load_started = time.perf_counter()
vae = PyTorchVAE(
    ModelConfig(),
    ComponentConfig(backend="pytorch", device="cpu", dtype="fp32"),
    model_snapshot=snapshot,
)
vae_load_seconds = time.perf_counter() - vae_load_started
vae_started = time.perf_counter()
audio = vae.decode(actual).detach().cpu()
vae_decode_seconds = time.perf_counter() - vae_started
wav_path = out_path.with_suffix(".wav")
write_pcm16_wav(wav_path, audio, int(vae.sample_rate))
after_decode = memory_sample()

baseline_audio_path = out_path.parent / "fp32-audio.pt"
if mode == "fp32":
    torch.save(audio, baseline_audio_path)
    expected_audio = audio
else:
    if not baseline_audio_path.is_file():
        raise SystemExit(f"Missing FP32 baseline audio: {baseline_audio_path}; include fp32 in MODES first")
    expected_audio = torch.load(baseline_audio_path, map_location="cpu", weights_only=True)
audio_metrics = similarity(audio, expected_audio)

result = {
    "mode": mode,
    "shape": list(actual.shape),
    "shape_match": actual.shape == expected_latent.shape,
    "dtype": str(actual.dtype),
    "min_weight_elements": min_weight_elements,
    "selected_linear_count": len(selected_names),
    "selected_weight_elements": selected_weight_elements,
    "quantized_weight_mb_equivalent": selected_weight_elements / (1024 * 1024),
    "quant_engine": quant_engine,
    "load_seconds": load_seconds,
    "quantize_seconds": quantize_seconds,
    "generate_seconds": generate_seconds,
    "realtime_factor": generate_seconds / 3.0,
    "latent": latent_metrics,
    "vae_load_seconds": vae_load_seconds,
    "vae_decode_seconds": vae_decode_seconds,
    "audio": audio_metrics,
    "wav_path": str(wav_path),
    "rss_before_mb": before.current_rss_mb,
    "rss_after_load_mb": after_load.current_rss_mb,
    "rss_after_quant_mb": after_quant.current_rss_mb,
    "rss_after_generate_mb": after_generate.current_rss_mb,
    "rss_after_decode_mb": after_decode.current_rss_mb,
    "generator_peak_rss_mb": max(
        before.peak_rss_mb,
        after_load.peak_rss_mb,
        after_quant.peak_rss_mb,
        after_generate.peak_rss_mb,
    ),
    "peak_rss_mb": max(
        before.peak_rss_mb,
        after_load.peak_rss_mb,
        after_quant.peak_rss_mb,
        after_generate.peak_rss_mb,
        after_decode.peak_rss_mb,
    ),
    "torch_num_threads": torch.get_num_threads(),
    "torch_num_interop_threads": torch.get_num_interop_threads(),
    "supported_quant_engines": list(torch.backends.quantized.supported_engines),
}
out_path.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
print(json.dumps(result, indent=2, sort_keys=True))
PY
done

OUT_DIR="$OUT_DIR" MODES="$MODES" "$PYTHON" - <<'PY'
from __future__ import annotations

import json
import os
from pathlib import Path

out_dir = Path(os.environ["OUT_DIR"])
modes = os.environ["MODES"].split()
results = {mode: json.loads((out_dir / f"{mode}.json").read_text()) for mode in modes}
fp32 = results.get("fp32")
summary: dict[str, object] = {"cases": results}
if fp32 is not None:
    comparisons: dict[str, object] = {}
    for mode, result in results.items():
        if mode == "fp32":
            continue
        comparisons[mode] = {
            "generator_speedup_vs_fp32": fp32["generate_seconds"] / result["generate_seconds"],
            "latent_snr_db": result["latent"]["snr_db"],
            "latent_cosine_similarity": result["latent"]["cosine_similarity"],
            "audio_snr_db": result["audio"]["snr_db"],
            "audio_cosine_similarity": result["audio"]["cosine_similarity"],
            "selected_linear_count": result["selected_linear_count"],
            "wav_path": result["wav_path"],
        }
    summary["comparisons"] = comparisons
print("\n================ SUMMARY ================")
print(json.dumps(summary, indent=2, sort_keys=True))
PY
